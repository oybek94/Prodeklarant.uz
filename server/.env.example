# Production uchun NODE_ENV=production qo'yish SHART.
# Production'da default/zaif qiymatlar bilan server ISHGA TUSHMAYDI (fail-fast).
NODE_ENV=production

# Admin panel paroli — mustahkam, noyob qiymat tanlang (admin123 ishlamaydi).
ADMIN_PASSWORD=

# JWT imzolash kaliti — kamida 24 belgi, tasodifiy.
# Masalan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Express server porti (nginx proxy_pass da shu port ko'rsatiladi).
# Production (app.prodeklarant.uz bilan bir serverda): PORT=3002; lokal: 3001
PORT=3002

# Saytning to'liq URL'i (sitemap va SEO uchun)
SITE_URL=https://prodeklarant.uz

# Blog tarjimasi uchun OpenAI kaliti (admin paneldagi avto-tarjima)
OPENAI_API_KEY=

# Contact formasi xabarlari shu Telegram bot/chat'ga yuboriladi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ixtiyoriy: qo'shimcha CORS originlar (vergul bilan ajratilgan)
# CORS_ORIGIN=https://boshqa-domen.uz,https://www.boshqa-domen.uz
