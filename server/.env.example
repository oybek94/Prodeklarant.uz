# Production uchun NODE_ENV=production qo'yish tavsiya etiladi
NODE_ENV=production

# Admin panel paroli
ADMIN_PASSWORD=admin123

# JWT imzolash uchun maxfiy kalit (production da mustahkam qiymat tanlang)
JWT_SECRET=your-secret-key-change-in-production

# Express server porti (nginx proxy_pass da shu port ko'rsatiladi)
PORT=3001

# Ixtiyoriy: qo'shimcha CORS originlar (vergul bilan ajratilgan)
# CORS_ORIGIN=https://boshqa-domen.uz,https://www.boshqa-domen.uz
